# A simpler version of the service template with wider compatibility for older OS's

[Unit]
Description=AELIG Mail email service
ConditionPathExists=/etc/aelig-mail/config.toml
Wants=network.target
# The PostgreSQL database may not be on the same host but if it
# is AELIG Mail should wait for it to start up.
After=postgresql.service

[Service]
Type=simple
PermissionsStartOnly=true
WorkingDirectory=/usr/bin
ExecStartPre=/usr/bin/mkdir -p "/etc/aelig-mail/uploads"
ExecStartPre=/usr/bin/aelig-mail --config /etc/aelig-mail/config.toml --upgrade --yes
ExecStart=/usr/bin/aelig-mail --config /etc/aelig-mail/config.toml
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

# To enable a static dir, add the following 
# --static-dir /etc/aelig-mail/static
# to the end of the ExecStart line above after creating the dir and fetching the files with:
# Place the static assets under /etc/aelig-mail/static before enabling this option.

# To enable a log file that persists after restarts, replace the ExecStart= line with:
# ExecStart=/bin/bash -ce "exec /usr/bin/aelig-mail --config /etc/aelig-mail/config.toml --static-dir /etc/aelig-mail/static >>/etc/aelig-mail/aelig-mail.log 2>&1"

# Set user to run the AELIG Mail service as (instead of root).
# Can use "DynamicUser=" instead, if your systemd version is >= 232.
# https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html#DynamicUser=
#User=
#StateDirectory=/etc/aelig-mail
#Environment=HOME=/usr/bin

# Use systemd’s ability to disable security-sensitive features
# that AELIG Mail does not explicitly need.
# NoNewPrivileges should be enabled by DynamicUser=yes but systemd-analyze
# still recommended to explicitly enable it.
NoNewPrivileges=True
# AELIG Mail doesn’t need any capabilities as defined by the linux kernel
# see: https://man7.org/linux/man-pages/man7/capabilities.7.html
CapabilityBoundingSet=
# AELIG Mail only executes native code with no need for any other ABIs.
SystemCallArchitectures=native

# Make /home/, /root/, and /run/user/ inaccessible.
# ProtectSystem=strict and ProtectHome=read-only are implied by DynamicUser=True
# If you set ExecStartPre=/usr/bin/mkdir -p "aelig-mail/uploads" to a directory in /home/ or /root/ it will cause uploads to fail 
# See the service setup documentation
ProtectHome=True

# Make sure files created by AELIG Mail are only readable by itself and
# others in the AELIG Mail system group.
UMask=0027
# AELIG Mail only needs to support the IPv4 and IPv6 address families.
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
